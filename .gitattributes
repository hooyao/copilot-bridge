# Captured official source bytes are hash-verified by contract tests. Keep the
# models payload byte-exact on Windows runners even when Git's global autocrlf
# setting differs from a developer checkout.
tests/Fixtures/Codex/**/models.json -text
tests/Fixtures/Codex/**/capture.json text eol=lf

# The bundled catalog snapshot is digest-verified against its recorded
# provenance at process start, so its bytes must survive checkout untouched.
# Without -text a Windows runner with autocrlf=true rewrites the payload and
# the digest guard fails the build (observed on PR #66 CI, where every local
# test passed and only the Windows job broke).
src/CopilotBridge.Cli/Catalogs/Codex/Bundled/models.json -text
src/CopilotBridge.Cli/Catalogs/Codex/Bundled/capture.json text eol=lf
